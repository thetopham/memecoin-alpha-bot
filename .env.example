# Solana / Helius
HELIUS_API_KEY=
SOLANA_RPC_URL=https://beta.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# Safety: v1 is dry-run/paper trading only. Leave true.
DRY_RUN=true

# Scanner thresholds
WATCHED_WALLETS_PATH=./config/watched-wallets.json
DB_PATH=./data/memecoin-alpha.sqlite
POLL_INTERVAL_SECONDS=10
SIGNATURE_LIMIT=12
MIN_WALLETS_FOR_SIGNAL=2
SIGNAL_WINDOW_SECONDS=300
MIN_COMPOSITE_SCORE=60
MAX_PAPER_POSITION_SOL=0.10
PAPER_SOL_USD_FOR_ESTIMATES=90
PAPER_COMPARISON_NOTIONAL_USD=100
STOP_LOSS_PERCENT=-40
TAKE_PROFIT_1_MULTIPLE=2
TAKE_PROFIT_2_MULTIPLE=3
TAKE_PROFIT_3_MULTIPLE=5

# Telegram alerts are optional. If omitted, alerts only print to logs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Grok/X hook placeholder for later CT momentum scanner.
GROK_API_KEY=
ENABLE_CT_SCANNER=false

# Cielo wallet discovery. API key stays in .env only; never commit it.
CIELO_API_KEY=
CIELO_API_BASE_URL=https://feed-api.cielo.finance
CIELO_APP_BASE_URL=https://app.cielo.finance
CIELO_CANDIDATE_PATH=./config/cielo-wallet-candidates.json
CIELO_DISCOVERY_REPORT_PATH=./data/cielo-wallet-discovery-report.json
CIELO_MIN_PNL_USD=500
CIELO_MIN_ROI_PERCENT=50
CIELO_MIN_WINRATE_PERCENT=45
CIELO_MAX_LAST_ACTIVE_HOURS=48
CIELO_MAX_CANDIDATES=60
CIELO_DISCOVERY_PAGES=2
CIELO_FEED_MIN_USD=25
CIELO_FEED_LOOKBACK_HOURS=24
CIELO_VETTING_SIGNATURE_LIMIT=40
