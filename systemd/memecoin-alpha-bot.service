[Unit]
Description=Memecoin Alpha Bot dry-run scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/thetopham/memecoin-alpha-bot
EnvironmentFile=/home/thetopham/memecoin-alpha-bot/.env
ExecStart=/home/thetopham/.local/bin/npm run start
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/thetopham/memecoin-alpha-bot/data /home/thetopham/memecoin-alpha-bot/config

[Install]
WantedBy=default.target
